{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revenue-os.local/schemas/signal.schema.json",
  "title": "Signal",
  "description": "An observed change or condition that might create economic value. Not yet an opportunity. See docs/revenue_os/GLOSSARY.md.",
  "type": "object",
  "required": ["signal_id", "signal_type", "topic", "observed_at", "sources", "confidence"],
  "properties": {
    "signal_id": { "type": "string", "pattern": "^SIG-[0-9A-Z]+$" },
    "signal_type": {
      "type": "string",
      "enum": ["demand_change", "price_change", "supply_change", "policy_change", "competitor_change", "technology_change", "seasonal_event", "sentiment_change", "other"]
    },
    "topic": { "type": "string" },
    "market_id": { "type": "string" },
    "geography": { "type": "array", "items": { "type": "string" } },
    "observed_at": { "type": "string", "format": "date-time" },
    "observed_value": {},
    "baseline_value": {},
    "velocity": { "type": "number", "description": "Rate of change, units defined per signal_type" },
    "novelty": { "type": "number", "minimum": 0, "maximum": 1 },
    "half_life_estimate_days": { "type": "number", "minimum": 0 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "evidence.schema.json" }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
